{"id": "r1-f1-sqrt-dependency", "input": "| 4 | 9 | 0 |\n#+TBLFM: $2=sqrt($1)::$3=$2+1\n", "laps": 1, "expected": "| 4 | 2 | 3 |\n#+TBLFM: $2=sqrt($1)::$3=$2+1\n"},
{"id": "r1-f1-divzero-dependency", "input": "| 4 | 9 | 0 |\n#+TBLFM: $2=1/0::$3=$2+1\n", "laps": 1, "expected": "| 4 | 1/0 | 1:0 |\n#+TBLFM: $2=1/0::$3=$2+1\n"},
{"id": "r1-f1-format-dependency", "input": "| 4 | 9 | 0 |\n#+TBLFM: $2=$1;%c::$3=$2+1\n", "laps": 1, "expected": "| 4 | \u0004 | #ERROR |\n#+TBLFM: $2=$1;%c::$3=$2+1\n"},
{"id": "r1-f1-flag-dependency", "input": "| 4 | 9 | 0 |\n#+TBLFM: $2=$1;T::$3=$2+1\n", "laps": 1, "expected": "| 4 | 00:00:04 | 1 |\n#+TBLFM: $2=$1;T::$3=$2+1\n"},
{"id": "r1-f1-row-dependency", "input": "| 4 | 9 | 0 |\n| 8 | 1 | 0 |\n#+TBLFM: @1$2=sqrt($1)::@2$3=@1$2+1\n", "laps": 1, "expected": "| 4 | 2 | 0 |\n| 8 | 1 | 3 |\n#+TBLFM: @1$2=sqrt($1)::@2$3=@1$2+1\n"},
{"id": "r1-f3-big-N", "input": "| 123456789012345678901234567890123456789012345678901234567890 | old |\n#+TBLFM: $2=$1;N\n", "laps": 1, "expected": "| 123456789012345678901234567890123456789012345678901234567890 | 123456789012345678901234567890123456789012345678901234567890 |\n#+TBLFM: $2=$1;N\n"},
{"id": "r1-f3-big-N-range", "input": "| 123456789012345678901234567890123456789012345678901234567890 | 1 | old |\n#+TBLFM: $3=vsum($1..$2);N\n", "laps": 1, "expected": "| 123456789012345678901234567890123456789012345678901234567890 | 1 | 123456789012345678901234567890123456789012345678901234567891 |\n#+TBLFM: $3=vsum($1..$2);N\n"},
{"id": "r1-f3-big-N-neg", "input": "| -123456789012345678901234567890123456789012345678901234567890 | old |\n#+TBLFM: $2=$1+1;N\n", "laps": 1, "expected": "| -123456789012345678901234567890123456789012345678901234567890 | -123456789012345678901234567890123456789012345678901234567889 |\n#+TBLFM: $2=$1+1;N\n"},
{"id": "r1-f3-big-printf-d", "input": "| old |\n#+TBLFM: $1=123456789012345678901234567890123456789012345678901234567890;%d\n", "laps": 1, "expected": "| 123456789012345678901234567890123456789012345678901234567890 |\n#+TBLFM: $1=123456789012345678901234567890123456789012345678901234567890;%d\n"},
{"id": "r1-f3-big-printf-s", "input": "| old |\n#+TBLFM: $1=123456789012345678901234567890123456789012345678901234567890;%s\n", "laps": 1, "expected": "| 123456789012345678901234567890123456789012345678901234567890 |\n#+TBLFM: $1=123456789012345678901234567890123456789012345678901234567890;%s\n"},
{"id": "r1-f4-crossed-hline-range", "input": "| 1 | 2 | 0 |\n|---+---+---|\n| 3 | 4 | 0 |\n#+TBLFM: @2$3=vsum(@I$1..@I$2)\n", "laps": 1, "expected": "| 1 | 2 | 0 |\n|---+---+---|\n| 3 | 4 | 2 |\n#+TBLFM: @2$3=vsum(@I$1..@I$2)\n"},
{"id": "r1-f4-two-hlines", "input": "| 1 | 2 | 0 |\n|---+---+---|\n|---+---+---|\n| 3 | 4 | 0 |\n#+TBLFM: @2$3=vsum(@I$1..@II$2)\n", "laps": 1, "expected": "| 1 | 2 | 0 |\n|---+---+---|\n|---+---+---|\n| 3 | 4 | 2 |\n#+TBLFM: @2$3=vsum(@I$1..@II$2)\n"},
